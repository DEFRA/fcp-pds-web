<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">
  <changeSet author="Sam Plackett" id="1">
    <tagDatabase tag="v1.0.0" />
  </changeSet>

  <changeSet author="Sam Plackett" id="2">
    <createTable tableName="schemes">
      <column name="schemeId" type="SMALLINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="scheme_pkey"/>
      </column>
      <column name="name" type="VARCHAR(50)"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="3">
    <createTable tableName="category">
      <column name="categoryId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="categoryId_pkey"/>
      </column>
      <column name="name" type="VARCHAR(25)"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="4">
    <createTable tableName="paymentRequests">
      <column name="paymentRequestId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="paymentRequestId_pkey"/>
      </column>
      <column name="schemeId" type="SMALLINT"/>
      <column name="sourceSystem" type="VARCHAR(50)"/>
      <column name="deliveryBody" type="VARCHAR(4)"/>
      <column name="invoiceNumber" type="VARCHAR(30)"/>
      <column name="frn" type="BIGINT"/>
      <column name="sbi" type="INTEGER"/>
      <column name="ledger" type="VARCHAR(2)"/>
      <column name="marketingYear" type="INTEGER"/>
      <column name="agreementNumber" type="VARCHAR(50)"/>
      <column name="contractNumber" type="VARCHAR(50)"/>
      <column name="paymentRequestNumber" type="INTEGER"/>
      <column name="currency" type="VARCHAR(3)"/>
      <column name="schedule" type="VARCHAR(3)"/>
      <column name="dueDate" type="VARCHAR(10)"/>
      <column name="originalSettlementDate" type="VARCHAR(10)"/>
      <column name="originalInvoiceNumber" type="VARCHAR(30)"/>
      <column name="invoiceCorrectionReference" type="VARCHAR(30)"/>
      <column name="value" type="INTEGER"/>
      <column name="received" type="TIMESTAMP"/>
      <column name="released" type="TIMESTAMP"/>
      <column name="referenceId" type="UUID"/>
      <column name="correlationId" type="UUID"/>
      <column name="netValue" type="INTEGER"/>
      <column name="categoryId" type="INTEGER"/>
      <column name="claimDate" type="VARCHAR(10)"/>
      <column name="exchangeRate" type="VARCHAR(10)"/>
      <column name="eventDate" type="VARCHAR(10)"/>
      <column name="vendor" type="VARCHAR(10)"/>
      <column name="trader" type="VARCHAR(10)"/>
      <column name="fesCode" type="VARCHAR(10)"/>
      <column name="annualValue" type="DECIMAL(14, 2)"/>
      <column name="remittanceDescription" type="VARCHAR(60)"/>
      <column name="providesAccountingValues" type="BOOLEAN" defaultValueBoolean="false"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="5">
    <createTable tableName="debtData">
      <column name="debtDataId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="debtDataId_pkey"/>
      </column>
      <column name="paymentRequestId" type="INTEGER"/>
      <column name="schemeId" type="SMALLINT"/>
      <column name="frn" type="BIGINT"/>
      <column name="reference" type="VARCHAR(50)"/>
      <column name="netValue" type="DECIMAL"/>
      <column name="debtType" type="VARCHAR(3)"/>
      <column name="recoveryDate" type="VARCHAR(10)"/>
      <column name="attachedDate" type="TIMESTAMP"/>
      <column name="createdDate" type="TIMESTAMP"/>
      <column name="createdBy" type="VARCHAR(50)"/>
      <column name="createdById" type="VARCHAR(255)"/>
      <column name="migrated" type="TIMESTAMP"/>
      <column name="migrationId" type="VARCHAR(20)"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="6">
    <createTable tableName="qualityChecks">
      <column name="qualityCheckId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="qualityCheckId_pkey"/>
      </column>
      <column name="paymentRequestId" type="INTEGER"/>
      <column name="checkedDate" type="TIMESTAMP"/>
      <column name="checkedBy" type="VARCHAR(50)"/>
      <column name="status" type="VARCHAR(50)"/>
      <column name="checkedById" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="7">
    <createTable tableName="invoiceLines">
      <column name="invoiceLineId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="invoiceLineId_pkey"/>
      </column>
      <column name="paymentRequestId" type="INTEGER"/>
      <column name="schemeCode" type="VARCHAR(10)"/>
      <column name="accountCode" type="VARCHAR(6)"/>
      <column name="fundCode" type="VARCHAR(6)"/>
      <column name="description" type="VARCHAR(255)"/>
      <column name="value" type="INTEGER"/>
      <column name="marketingYear" type="INTEGER"/>
      <column name="agreementNumber" type="VARCHAR(255)"/>
      <column name="deliveryBody" type="VARCHAR(4)"/>
      <column name="stateAid" type="BOOLEAN" defaultValueBoolean="false"/>
      <column name="convergence" type="BOOLEAN" defaultValueBoolean="false"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="8">
    <createTable tableName="manualLedgerPaymentRequest">
      <column name="manualLedgerPaymentRequestId" type="INTEGER" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="manualLedgerPaymentRequestId_pkey"/>
      </column>
      <column name="paymentRequestId" type="INTEGER"/>
      <column name="ledgerPaymentRequestId" type="INTEGER"/>
      <column name="createdBy" type="VARCHAR(50)"/>
      <column name="createdDate" type="TIMESTAMP"/>
      <column name="active" type="BOOLEAN"/>
      <column name="original" type="BOOLEAN"/>
      <column name="createdById" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>

  <changeSet author="Sam Plackett" id="9">
    <addForeignKeyConstraint baseTableName="paymentRequests" baseColumnNames="schemeId"
        constraintName="fk_paymentRequest_schemeId"
        referencedTableName="schemes" referencedColumnNames="schemeId"/>
    <addForeignKeyConstraint baseTableName="paymentRequests" baseColumnNames="categoryId"
        constraintName="fk_paymentRequests_categoryId"
        referencedTableName="category" referencedColumnNames="categoryId"/>
    <addForeignKeyConstraint baseTableName="debtData" baseColumnNames="schemeId"
        constraintName="fk_debtData_schemeId"
        referencedTableName="schemes" referencedColumnNames="schemeId"/>
    <addForeignKeyConstraint baseTableName="debtData" baseColumnNames="paymentRequestId"
        constraintName="fk_debtData_paymentRequestId"
        referencedTableName="paymentRequests" referencedColumnNames="paymentRequestId"/>
    <addForeignKeyConstraint baseTableName="qualityChecks" baseColumnNames="paymentRequestId"
        constraintName="fk_qualityChecks_paymentRequestId"
        referencedTableName="paymentRequests" referencedColumnNames="paymentRequestId"/>
    <addForeignKeyConstraint baseTableName="invoiceLines" baseColumnNames="paymentRequestId"
        constraintName="fk_invoiceLines_paymentRequestId"
        referencedTableName="paymentRequests" referencedColumnNames="paymentRequestId"/>
    <addForeignKeyConstraint baseTableName="manualLedgerPaymentRequest" baseColumnNames="paymentRequestId"
        constraintName="fk_manualLedger_paymentRequestId"
        referencedTableName="paymentRequests" referencedColumnNames="paymentRequestId"/>
    <addForeignKeyConstraint baseTableName="manualLedgerPaymentRequest" baseColumnNames="ledgerPaymentRequestId"
        constraintName="fk_manualLedger_ledgerPaymentRequestId"
        referencedTableName="paymentRequests" referencedColumnNames="paymentRequestId"/>
  </changeSet>

  <changeSet author="Sam Plackett" id="10">
    <createIndex indexName="idx_debt_data_payment_request_id" tableName="debtData">
      <column name="paymentRequestId"/>
    </createIndex>
    <createIndex indexName="idx_debt_data_scheme_id" tableName="debtData">
      <column name="schemeId"/>
    </createIndex>
    <createIndex indexName="idx_invoice_lines_payment_request_id" tableName="invoiceLines">
      <column name="paymentRequestId"/>
    </createIndex>
    <createIndex indexName="idx_manual_ledger_ledger_payment_request_id" tableName="manualLedgerPaymentRequest">
      <column name="ledgerPaymentRequestId"/>
    </createIndex>
    <createIndex indexName="idx_manual_ledger_payment_request_id" tableName="manualLedgerPaymentRequest">
      <column name="paymentRequestId"/>
    </createIndex>
    <createIndex indexName="idx_payment_requests_scheme_id" tableName="paymentRequests">
      <column name="schemeId"/>
    </createIndex>
    <createIndex indexName="idx_payment_requests_category_id" tableName="paymentRequests">
      <column name="categoryId"/>
    </createIndex>
    <createIndex indexName="idx_quality_checks_payment_request_id" tableName="qualityChecks">
      <column name="paymentRequestId"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>